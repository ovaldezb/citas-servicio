  "description": "Sistema de citas por WhatsApp con integración a Google Calendar",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "deploy": "npm run build && serverless deploy",
    "test": "jest",
